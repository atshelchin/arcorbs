{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// `wrangler types` points at the built worker once there is one. It is build output, not ours to check.
		"checkJs": false,
		"types": ["$app/types", "node", "./worker-configuration.d.ts"]
	},
	"include": ["src", "vite.config.ts", "playwright.config.ts"]
}
